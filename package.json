{
  "name": "@herowcode/workflow",
  "version": "1.3.1",
  "description": "CLI wizard to generate GitHub Actions workflows for herowcode projects",
  "bin": {
    "workflow": "./dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && chmod +x dist/cli.cjs",
    "lint": "biome lint --diagnostic-level=error --no-errors-on-unmatched",
    "lint:fix": "biome check --write --unsafe",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "version:patch": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && npm version patch && git push && git push --tags",
    "version:minor": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && npm version minor && git push && git push --tags",
    "version:major": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && npm version major && git push && git push --tags"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/node": "22.12.0",
    "@vitest/coverage-v8": "3.2.7",
    "tsup": "8.5.1",
    "typescript": "^7.0.2",
    "vitest": "3.2.7"
  },
  "author": {
    "name": "Judson Junior",
    "email": "judson.junior@herowcode.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herowcode/workflow.git"
  },
  "bugs": {
    "url": "https://github.com/herowcode/workflow/issues"
  },
  "homepage": "https://github.com/herowcode/workflow#readme",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ],
    "overrides": {
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "packageManager": "pnpm@10.30.1"
}
